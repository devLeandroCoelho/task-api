{
  "name": "task-api",
  "version": "2.0.0",
  "description": "RESTful API for task management — Vercel Serverless + Supabase",
  "main": "api/auth/register.ts",
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Add eslint here'",
    "clean": "rm -rf .vercel"
  },
  "keywords": [
